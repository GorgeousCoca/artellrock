# Канонический URL без слэша в конце. Локально: http://localhost:3000
# Docker/VPS (production): https://artellrock.ru — тот же URL должен передаваться при docker build (см. Dockerfile, docker-compose).
# Данные сайта и админки — JSON (`src/content/cms-store.json`), отдельная БД в проекте не используется.
NEXT_PUBLIC_SITE_URL="https://artellrock.ru"

# Опционально: подкаталог на GitHub Pages (см. next.config.ts). На своём домене обычно не нужен.
#NEXT_PUBLIC_BASE_PATH=

# Standalone-сборка Next (`output: "standalone"`). В Docker образе задаётся в Dockerfile (ENV NEXT_STANDALONE=true).
# Для локальной проверки `next build` + standalone вне Docker можно выставить true.
#NEXT_STANDALONE=true

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-long-random-secret-at-least-32-chars"
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="mail@example.com"
SMTP_PASSWORD="mail-password"
MAIL_TO="mail@example.com"
MAIL_FROM="mail@example.com"
