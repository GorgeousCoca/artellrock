# Публичный URL сайта. Локально: http://localhost:3000
# Docker/VPS (production): https://artellrock.ru — этот URL попадает в метаданные при docker build (см. Dockerfile, docker-compose).
NEXT_PUBLIC_SITE_URL="https://artellrock.ru"

# Standalone-сборка Next (`output: "standalone"`). В Docker включается в Dockerfile (ENV NEXT_STANDALONE=true).
#NEXT_STANDALONE=true

# --- Payload CMS (/admin) -------------------------------------------------
# Строка подключения к Postgres. Локально: `docker compose up -d postgres` (порт 5432 только на localhost).
# В docker-compose для сервиса web значение подставляется автоматически.
DATABASE_URI="postgres://artellrock:artellrock@localhost:5432/artellrock"
POSTGRES_PASSWORD="artellrock"
# Длинная случайная строка (32+ символов). Например: openssl rand -hex 32
PAYLOAD_SECRET="replace-with-long-random-secret-at-least-32-chars"

# Первый администратор: создайте на /admin или командой `npm run admin:create` (ADMIN_CREATE_EMAIL / ADMIN_CREATE_PASSWORD).
# Можно оставить пустым и создать пользователя на /admin (create-first-user).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Импорт цен камней (npm run import:prices): под этим пользователем скрипт сбрасывает кэш работающего сервера.
# Если не заданы, берутся ADMIN_EMAIL/ADMIN_PASSWORD. Адрес сервера: IMPORT_BASE_URL (по умолчанию http://localhost:3000).
# PRICES_ADMIN_EMAIL=""
# PRICES_ADMIN_PASSWORD=""

# --- Почта заявок ---------------------------------------------------------
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="mail@example.com"
SMTP_PASSWORD="mail-password"
MAIL_TO="mail@example.com"
MAIL_FROM="mail@example.com"
